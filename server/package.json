{
  "name": "qlicker-server",
  "version": "1.0.0",
  "description": "Qlicker Fastify backend server",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "migrate:question-types": "node scripts/migrate-question-types.js",
    "migrate:question-types:apply": "node scripts/migrate-question-types.js --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@azure/storage-blob": "^12.33.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/argon2": "^2.1.0",
    "@node-saml/node-saml": "^5.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "file-type": "^22.0.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "nodemailer": "^9.0.5",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@fastify/static": "10.1.3",
    "@xmldom/xmldom": "0.8.13",
    "brace-expansion": "5.0.9",
    "fast-xml-parser": ">=5.7.0",
    "follow-redirects": "1.16.0",
    "yaml": "2.8.3"
  }
}
